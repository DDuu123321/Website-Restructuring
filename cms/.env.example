# ─── Server ───────────────────────────────────────────────
SERVER_URL=http://localhost:3001
PORT=3001
NODE_ENV=development

# ─── Payload ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace_with_64_char_random_string

# ─── Database — PostgreSQL ────────────────────────────────
# Local Postgres:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/bluven
#
# Railway / Neon / Supabase (managed):
#   DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bluven

# ─── Email — Zoho SMTP ────────────────────────────────────
# Use an App Password generated in Zoho (Mail → Settings → Security
# → App Passwords). The account login password will NOT work for SMTP.
#
# SMTP_HOST: smtp.zoho.com (worldwide) or smtp.zoho.com.au (AU region)
# SMTP_PORT: 465 (SSL — recommended) or 587 (STARTTLS)
SMTP_HOST=smtp.zoho.com.au
SMTP_PORT=465
SMTP_USER=system@yourdomain.com
SMTP_PASS=your_zoho_app_password

EMAIL_FROM=system@yourdomain.com
NOTIFY_EMAIL=system@yourdomain.com

# ─── AI Chat proxy ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Frontend origin (CORS / CSRF allow-list for the public site) ──────
# Production: https://www.bluven.com.au. Consumed by the Express CORS
# middleware (server.ts) AND Payload's built-in CORS/CSRF. Must match the
# served origin EXACTLY (scheme + www, no trailing slash).
FRONTEND_URL=http://localhost:3000

# ─── Media storage — Cloudflare R2 (S3-compatible) ────────
# Leave ALL FOUR blank for local-disk uploads (local dev). Set all four to
# enable R2 — REQUIRED in production: Railway's filesystem is ephemeral, so
# local-disk uploads are wiped on every redeploy. Create a PRIVATE bucket + an
# "Object Read & Write" API token in the Cloudflare R2 dashboard.
# R2_ENDPOINT is the account-level endpoint (no bucket name in the host).
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── CRM lead sync (optional) ─────────────────────────────
# Leave blank to keep GET /api/crm/leads disabled (returns 503). Set a shared
# secret to let the standalone CRM pull leads via Bearer auth.
CRM_SYNC_KEY=
