# Payload 2's admin dependency tree has long-standing React peer conflicts
# (@dnd-kit expects React <=18 peers that other packages redeclare differently).
# Local installs were already done with --legacy-peer-deps; this makes CI
# installs (Railway nixpacks runs plain `npm ci`) behave identically instead of
# failing on ERESOLVE.
legacy-peer-deps=true

# The service runs with NODE_ENV=production, which Railway also injects at
# BUILD time — and npm's `omit` config defaults to "dev" whenever
# NODE_ENV=production, so `npm ci` silently skipped devDependencies and the
# build died on `cross-env: not found` (tsc would have been next). The build
# needs devDependencies (cross-env, typescript); runtime uses the same image,
# so there is no prune step this could interfere with.
include=dev
