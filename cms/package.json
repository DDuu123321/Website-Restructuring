{
  "name": "bluven-cms",
  "version": "1.0.0",
  "description": "Bluven Energy — Payload CMS backend",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation nodemon --watch src --ext ts,json --exec ts-node src/server.ts",
    "build": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload build && tsc",
    "start": "node dist/server.js",
    "migrate": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "migrate:prod": "PAYLOAD_CONFIG_PATH=dist/payload.config.js payload migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/lib-storage": "^3.1073.0",
    "@payloadcms/bundler-webpack": "^1.0.7",
    "@payloadcms/db-postgres": "0.8.10",
    "@payloadcms/plugin-cloud-storage": "1.2.2",
    "@payloadcms/richtext-lexical": "0.11.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "0.32.1",
    "express": "^4.18.3",
    "express-rate-limit": "^7.3.1",
    "graphql": "16.8.1",
    "helmet": "^7.1.0",
    "nodemailer": "^8.0.8",
    "papaparse": "^5.5.3",
    "payload": "2.32.3",
    "pg": "^8.11.5",
    "sharp": "^0.33.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "@payloadcms/db-postgres": {
      "drizzle-kit": "0.23.2"
    }
  }
}
